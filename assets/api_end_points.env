# Template — copy to api_end_points.env and fill in real values.
#   cp api_end_points.env.example api_end_points.env
#
# These are endpoint paths and base URLs only — no credentials belong here.

# Base URLs
BASE_URL_DEV=https://testvendorapi.2p.com.sa
BASE_URL_STAGE=https://testvendorapi.2p.com.sa
BASE_URL_PROD=https://testvendorapi.2p.com.sa

# Auth Apis
GET_USER_RULE=
FORGOT_PASSWORD_ENDPOINT=/api/v1/auth/forgot-password
RESET_PASSWORD_ENDPOINT=/api/v1/auth/reset-password
REFRESH_LOGIN_ENDPOINT=/api/v1/auth/refresh
GET_CAPTCHA_ENDPOINT=/api/v1/captcha
VERIFY_CAPTCHA_ENDPOINT=/api/v1/captcha/verify

# ID Card Profile Apis
GET_EMPLOYEE_PROFILE=

# Student Apis
GET_STUDENT_PROFILE=
GET_STUDENT_CERTIFICATE=
GET_STUDENT_TABLE=
GET_STUDENT_ACADEMIC_TRANSCRIPT=
GET_STUDENT_STUDY_PLAN=
GET_STUDENT_ATTENDANCE_HEADER=
GET_STUDENT_ATTENDANCE_DETAILS=

# Configurations Api
CONFIGURATIONS_ENDPOINT=

# Employee Certificate Api
EMPLOYEE_CERTIFICATE_ENDPOINT=

# Leave Balance Api
GET_EMPLOYEE_ACCRUAL=

# Payroll Register Api
GET_EMPLOYEE_SALARY=

# Lookups Apis
GET_ALL_COUNTRIES_ENDPOINT=/api/v1/countries
LOOKUP_DOCUMENT_TYPES=/api/v1/registration/document-types
LOOKUP_ANNOUNCEMENT_TYPE=
LOOKUP_NEWS_TYPE=
LOOKUP_CALENDAR_CLASSIFICATION=
LOOKUP_FAQS_CATEGORY=
LOOKUP_TARGET_GROUP=
LOOKUP_POLICY_CLASSIFICATION=
LOOKUP_TOPIC=
LOOKUP_CALENDAR_SEMESTER=

#Registration Apis
REGISTER_SUPPLIER_ENDPOINT=/api/v1/registration
RESTISTER_SUPPLIER_ENDPOINT=/api/v1/registration

# Orders Apis
GET_ORDERS_ENDPOINT=/api/v1/orders

# Claims Apis
GET_CLAIMS_ENDPOINT=/api/v1/claims
POST_CLAIM_ENDPOINT=/api/v1/claims

# Profile Apis
GET_PROFILE_ENDPOINT=/api/v1/profile

# Shared Apis
GET_ANNOUNCEMENTS=
GET_NEWS=
GET_ACADEMIC_CALENDAR=
GET_FAQS=
GET_POLICIES=
GET_NODE=